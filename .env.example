# Application. Demo mode is fully local. Production mode refuses to start until
# every required live provider and durable store below is configured.
APP_ENVIRONMENT=development
RUNTIME_MODE=demo
# Only production uses this selector. `live` requires the approved AgriStack
# gateway; `synthetic` keeps production orchestration/auth/storage real while
# every farmer, consent, and knowledge record is explicitly synthetic and
# review-only until the live gateway is approved.
PRODUCTION_DATA_MODE=live
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HITL_CONFIDENCE_THRESHOLD=0.70
SAFETY_RULE_SET_VERSION=synthetic-demo-2026.07
RETENTION_DAYS=30

# API security. For local hackathon demos set AUTH_REQUIRED=true and use the
# example principals below (also listed in REVIEWER_CREDENTIALS.example.md).
# Production must inject credentials through a secret manager — never commit real keys.
AUTH_REQUIRED=true
AUTH_PRINCIPALS_JSON=[{"api_key":"farmer-demo-key-0123456789abcdef","subject":"farmer-asha","roles":["farmer"],"allowed_farmer_ids":["AGR_MH_001234"],"allowed_regions":["Maharashtra"],"email":"asha.patil@demo.sasyaai.local"},{"api_key":"officer-west-demo-key-0123456789ab","subject":"officer-west","roles":["extension_officer"],"allowed_regions":["Maharashtra","Gujarat","Rajasthan","Madhya Pradesh","Goa"],"email":"officer.west@demo.sasyaai.local"},{"api_key":"officer-south-demo-key-0123456789a","subject":"officer-south","roles":["extension_officer"],"allowed_regions":["Karnataka","Telangana","Tamil Nadu","Andhra Pradesh","Kerala"],"email":"officer.south@demo.sasyaai.local"},{"api_key":"admin-demo-key-0123456789abcdef0","subject":"system-admin","roles":["system_admin"],"email":"admin@demo.sasyaai.local"}]
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_FARMER_REQUESTS=60
RATE_LIMIT_OFFICER_REQUESTS=120
RATE_LIMIT_ADMIN_REQUESTS=240
GOOGLE_OAUTH_ENABLED=false
# Farmer login does not require an API key. Prefer Email OTP, Register new farmer,
# or POST /api/v1/auth/google/demo (registered emails only). API keys remain available for reviewers/ops.

# Initial LLM provider. Gemini has a limited free development tier, but any
# real startup deployment needs a usage budget and paid-scale quota. Never add
# this value to the frontend or commit it to the repository.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Validated low-latency model for the free-tier launch profile. Pin another
# model only after validating access, structured JSON support, and quota.
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# Durable production stores. DATABASE_URL must use PostgreSQL in production;
# Qdrant persists vector knowledge and farmer-scoped episode memory.
DATABASE_URL=postgresql+psycopg://sasyaai:change-me@postgres:5432/sasyaai

# Qdrant vector store
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE_DIR=

# Live data sources. Weather defaults to Open-Meteo; market and AgriStack
# values come from the approved provider gateway/secret manager.
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
MARKET_API_BASE_URL=
MARKET_API_KEY=
AGRISTACK_API_BASE_URL=
AGRISTACK_ACCESS_TOKEN=
TOOL_TIMEOUT_SECONDS=8
TOOL_MAX_RETRIES=2

# Optional production tracing. When unset, the API still exposes /metrics and
# keeps request instrumentation local; configure an OTLP collector for export.
OTEL_EXPORTER_OTLP_ENDPOINT=
SERVICE_VERSION=0.2.0

# Optional future Lyzr orchestration integration. The built-in production
# workflow uses the provider adapter above until this is explicitly enabled.
LYZR_API_KEY=
LYZR_WORKFLOW_ID=
LYZR_BASE_URL=https://api.lyzr.ai

# Runtime files are written to var/ and must never contain production PII.
