# Application
APP_ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HITL_CONFIDENCE_THRESHOLD=0.70

# Lyzr orchestration (optional — local deterministic workflow works without these)
LYZR_API_KEY=
LYZR_WORKFLOW_ID=
LYZR_BASE_URL=https://api.lyzr.ai

# Qdrant vector store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Embedding model (multilingual for Hindi/Marathi demo)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Runtime files are written to var/ and must never contain production PII.
