# Application
APP_ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HITL_CONFIDENCE_THRESHOLD=0.70
SAFETY_RULE_SET_VERSION=synthetic-demo-2026.07
RETENTION_DAYS=30

# API security. Keep false only for the local synthetic demo. Non-development
# deployments must set AUTH_REQUIRED=true and inject credentials through a
# secret manager, never through a tracked file or browser variable.
AUTH_REQUIRED=false
AUTH_PRINCIPALS_JSON=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Lyzr orchestration (optional — local deterministic workflow works without these)
LYZR_API_KEY=
LYZR_WORKFLOW_ID=
LYZR_BASE_URL=https://api.lyzr.ai

# Qdrant vector store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Embedding model (multilingual for Hindi/Marathi demo)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Runtime files are written to var/ and must never contain production PII.
