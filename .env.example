# Lyzr orchestration (optional — local orchestrator works without these)
LYZR_API_KEY=
LYZR_WORKFLOW_ID=
LYZR_BASE_URL=https://api.lyzr.ai

# Qdrant vector store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Embedding model (multilingual for Hindi/Marathi demo)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# API server
API_HOST=0.0.0.0
API_PORT=8000

# HITL queue file (extension officer approvals)
HITL_QUEUE_PATH=infra/hitl/queue.json
